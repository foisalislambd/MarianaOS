# Copy to .env and fill in

# LLM (OpenRouter recommended)
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-your-key
# Optional — leave empty for provider defaults
LLM_MODEL=
LLM_VISION_MODEL=

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ALLOWED_USERS=123456789

# Agent
AGENT_WORKSPACE=C:\Users\ifois\Desktop
TOOL_DISCOVERY=true
LOG_LEVEL=INFO
