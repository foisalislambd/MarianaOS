# MarianaOS Agent Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM PROVIDER
# =============================================================================
# Pick one: openai | gemini | anthropic | openrouter | groq | deepseek
#           mistral | xai | together | fireworks | ollama | lmstudio | custom
#
# Gemini (Google AI Studio) example:
#   LLM_PROVIDER=gemini
#   LLM_API_KEY=your_aistudio_key
#   (model defaults to gemini-2.5-flash — override with LLM_MODEL if you want)
#
# OpenCode Zen FREE (no real key — from OmniRoute / opencode.ai/zen):
#   LLM_PROVIDER=opencode
#   LLM_API_KEY=opencode
#   LLM_MODEL=deepseek-v4-flash-free
#   LLM_VISION_MODEL=deepseek-v4-flash-free
#   Other free ids: big-pickle, mimo-v2.5-free, longcat-2.0-free, nemotron-3-ultra-free, …
#   List: python list_models.py opencode
#
# OpenAI example:
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-...
#
# OpenRouter (many models, one key):
#   LLM_PROVIDER=openrouter
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=google/gemini-2.5-flash
#   LLM_VISION_MODEL=google/gemini-2.5-flash

LLM_PROVIDER=opencode
LLM_API_KEY=opencode

# Optional overrides (leave empty to use provider defaults)
LLM_BASE_URL=
LLM_MODEL=
LLM_VISION_MODEL=
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# =============================================================================
# Telegram
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Comma-separated Telegram user IDs allowed to control the PC (required for safety)
TELEGRAM_ALLOWED_USERS=123456789

# =============================================================================
# Agent
# =============================================================================
AGENT_NAME=MarianaOS
AGENT_MAX_TOOL_ROUNDS=25
AGENT_SCREENSHOT_DIR=data/screenshots
AGENT_WORKSPACE=C:\Users\ifois\Desktop
# Cursor IDE executable (leave empty to auto-detect)
CURSOR_PATH=
# Require confirm=true on destructive tools (delete, shell, write, move)
REQUIRE_CONFIRMATION=false

# Tool discovery: only send a core tool set to the LLM (saves tokens).
# Agent calls search_tools(query="...") to unlock more tools for that run.
TOOL_DISCOVERY=true
# Optional override of core tools (comma-separated). Empty = built-in default.
# TOOL_CORE=search_tools,list_tool_catalog,list_directory,read_file,take_screenshot,cursor_select_model

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
