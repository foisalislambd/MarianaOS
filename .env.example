# MarianaOS Agent Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM PROVIDER (httpx OpenAI-compatible)
# =============================================================================
# Recommended: openrouter | also: openai | groq | deepseek | mistral | xai | ollama | lmstudio
#
# OpenRouter (many models, one key) — recommended:
#   LLM_PROVIDER=openrouter
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=google/gemini-2.5-flash
#   LLM_VISION_MODEL=google/gemini-2.5-flash
#
# OpenAI:
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-...

LLM_PROVIDER=openrouter
LLM_API_KEY=your_openrouter_api_key

# Optional overrides (leave empty to use provider defaults)
LLM_BASE_URL=
LLM_MODEL=
LLM_VISION_MODEL=
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# =============================================================================
# Telegram
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Comma-separated Telegram user IDs allowed to control the PC
TELEGRAM_ALLOWED_USERS=123456789

# =============================================================================
# Agent
# =============================================================================
AGENT_NAME=MarianaOS
AGENT_MAX_TOOL_ROUNDS=25
AGENT_SCREENSHOT_DIR=data/screenshots
AGENT_WORKSPACE=C:\Users\ifois\Desktop
# Cursor IDE executable (leave empty for auto-detect)
CURSOR_PATH=
REQUIRE_CONFIRMATION=false

# Tool discovery: only send a core tool set to the LLM (saves tokens).
TOOL_DISCOVERY=true
# Optional override of core tools (comma-separated). Empty = built-in default.
# TOOL_CORE=search_tools,get_ui_tree,click_control,list_directory,read_file

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
